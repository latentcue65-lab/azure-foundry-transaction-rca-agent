# Copy to .env. Default mode uses a REAL registered Foundry agent.
RCA_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=
FOUNDRY_AGENT_NAME=sphere-transaction-rca
# Filled by `rca register`; pin the version to keep demos reproducible.
FOUNDRY_AGENT_VERSION=
# DefaultAzureCredential supports an Azure CLI login or configured service principal.
# Never commit credentials. `rca doctor --live` checks connectivity.

RCA_DATA_DIR=data
RCA_OUTPUT_DIR=outputs
# The bundled mock runs at this address. A static Mocki JSON endpoint also works.
RCA_MOCK_API_URL=http://127.0.0.1:8091/events
RCA_HTTP_TIMEOUT=5
RCA_MAX_TURNS=12
RCA_MAX_TOOL_CALLS=18
RCA_DEADLINE_SECONDS=180
RCA_PAGE_SIZE=100
RCA_MAX_EVENTS=1000
# Local, single-user POC: the API binds to loopback by default.
